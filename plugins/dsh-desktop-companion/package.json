{
  "name": "dsh-desktop-companion",
  "description": "DeepSeek Harness Desktop 的桌面伴生插件：更新/诊断/桌面设置 UI、托盘事件中继与外部链接失败提示等壳集成能力。Desktop shell companion for dotnet-deepseek-harness-desktop.",
  "version": "0.0.17",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  }
}
