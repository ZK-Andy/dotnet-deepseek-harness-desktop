<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- 与主工程一致的编码规范强制（见 docs/coding-standards.md）：build 按 .editorconfig
         执行 IDE 风格规则 + 启用的 StyleCop 规则，保持测试工程同样 0 警告。
         GenerateDocumentationFile：公共测试成员（xunit 测试类/方法均 public）同样受
         XML 文档契约（CS1591）约束 + IDE0005 双侧强制。 -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="StyleCop.Analyzers" PrivateAssets="all" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <!-- 命名空间升级（B4）后的全局 using：宿主壳测试消费全部三层命名空间（含本工程 Services*，
         其类型经既有显式 using 或命名空间解析可达）。 -->
    <Using Include="DeepSeek.Harness.Desktop.Core" />
    <Using Include="DeepSeek.Harness.Desktop.Core.Update" />
    <Using Include="DeepSeek.Harness.Desktop.Infrastructure" />
    <Using Include="DeepSeek.Harness.Desktop.Infrastructure.Tray" />
    <Using Include="DeepSeek.Harness.Desktop.Infrastructure.Update" />
    <Using Include="DeepSeek.Harness.Desktop.Services" />
    <Using Include="DeepSeek.Harness.Desktop.Services.Tray" />
    <Using Include="DeepSeek.Harness.Desktop.Services.Update" />
  </ItemGroup>

  <ItemGroup>
    <!-- 镜像拆分（官方判据 7）：Ryn 宿主壳/组合根测试归 Presentation 层测试工程。 -->
    <ProjectReference Include="..\..\src\DeepSeek.Harness.Desktop\DeepSeek.Harness.Desktop.csproj" />
    <ProjectReference Include="..\..\src\DeepSeek.Harness.Desktop.Core\DeepSeek.Harness.Desktop.Core.csproj" />
    <ProjectReference Include="..\..\src\DeepSeek.Harness.Desktop.Infrastructure\DeepSeek.Harness.Desktop.Infrastructure.csproj" />
  </ItemGroup>

</Project>
