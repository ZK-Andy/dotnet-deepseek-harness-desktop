<Project>

  <!-- 中央包管理（CPM，官方判据 8，ADR official-clean-architecture-adoption B4）：
       包版本单一事实源；各 csproj 的 PackageReference 只声明引用不带 Version。 -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="StyleCop.Analyzers" Version="1.1.118" />
    <PackageVersion Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.7.23" />
    <!-- D003 自研分析器（DSH0001）的编译期依赖：钉 4.13.0（分析器引用版本 ≤ 编译器版本即前向兼容；
         本地 .dotnet-cache 已有该版，离线可还原；CI 在线还原同版）。 -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.13.0" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <!-- Avalonia 宿主（ADR implemented/architecture/2026-10-22-avalonia-host-migration）：
         12.1.x 桌面栈 + 包自带 WebView 桥；旧 Ryn 宿主已随迁移收尾下线。 -->
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Controls.WebView" Version="12.1.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>

</Project>
