<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Infrastructure 的硬约束：只准引用 Core（R2 依赖方向，编译器强制 + ArchitectureTests
         项目引用断言）——主工程（Presentation）单向引用本工程，反向引用即成环编译失败。
         端口（接口）在 Core、适配器实现在本工程，组合根注入（R3）。 -->
    <NoWarn>$(NoWarn);EnableGenerateDocumentationFile</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="StyleCop.Analyzers" PrivateAssets="all" />
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- 全局 using：上游 Core 各域端口与本层各域实现（目录即命名空间）免逐文件 using。 -->
    <Using Include="DeepSeek.Harness.Desktop.Core" />
    <Using Include="DeepSeek.Harness.Desktop.Core.Update" />
    <Using Include="DeepSeek.Harness.Desktop.Core.Plugins" />
    <Using Include="DeepSeek.Harness.Desktop.Core.PageHealth" />
    <Using Include="DeepSeek.Harness.Desktop.Core.Localization" />
    <Using Include="DeepSeek.Harness.Desktop.Core.Bootstrap" />
    <Using Include="DeepSeek.Harness.Desktop.Infrastructure" />
    <Using Include="DeepSeek.Harness.Desktop.Infrastructure.Update" />
    <Using Include="DeepSeek.Harness.Desktop.Infrastructure.Bootstrap" />
    <Using Include="DeepSeek.Harness.Desktop.Infrastructure.Runtime" />
    <Using Include="DeepSeek.Harness.Desktop.Infrastructure.CliShim" />
    <Using Include="DeepSeek.Harness.Desktop.Infrastructure.Plugins" />
    <Using Include="DeepSeek.Harness.Desktop.Infrastructure.Platform" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeepSeek.Harness.Desktop.Core\DeepSeek.Harness.Desktop.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DeepSeek.Harness.Desktop" />
    <InternalsVisibleTo Include="DeepSeek.Harness.Desktop.Core.Tests" />
    <InternalsVisibleTo Include="DeepSeek.Harness.Desktop.Infrastructure.Tests" />
    <InternalsVisibleTo Include="DeepSeek.Harness.Desktop.Tests" />
  </ItemGroup>

</Project>
