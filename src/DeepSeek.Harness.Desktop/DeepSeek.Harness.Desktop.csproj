<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- IDE0005（移除无谓 using）：已由根 .editorconfig 开启为 warning，经 `dotnet format` 门禁强制
         （见 ci.yml，无需 GenerateDocumentationFile）。GenerateDocumentationFile 不在主工程开启——Ryn.Callbacks
         源生成器会为 [RynCallback] 类产出 public DI 扩展（RynNavigationCallbacksRynExtensions.AddRynNavigationCallbacks），
         生成符号无法手写其 XML 文档，且 `// <auto-generated />` 头与 .editorconfig 路径 glob 均无法对
         编译期内存生成文件抑制 CS1591；全局 NoWarn 又会连带压制手写公共 API 的缺文档（歧义），故不开启。 -->
    <NoWarn>$(NoWarn);EnableGenerateDocumentationFile</NoWarn>
    <!-- 发布产物为 JIT：三条打包流水线均显式 JIT publish（macOS 交叉编需关 AOT），
         此处声明 false 使本地 publish 与发运一致。AOT 兼容（源生成 JSON）保留为裕度，
         周期验证可临时 -p:PublishAot=true。 -->
    <PublishAot>false</PublishAot>
    <!-- 自更新比较基准；发布时 CI 以 -p:Version=$(tag 去前缀) 覆盖 -->
    <Version>0.5.4</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Ryn" />
    <PackageReference Include="Ryn.Plugins.Tray" />
    <PackageReference Include="Ryn.Callbacks" />
    <PackageReference Include="StyleCop.Analyzers" PrivateAssets="all" />
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" PrivateAssets="all" />
    <PackageReference Include="Ryn.Ipc.Generator"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeepSeek.Harness.Desktop.Core\DeepSeek.Harness.Desktop.Core.csproj" />
    <ProjectReference Include="..\DeepSeek.Harness.Desktop.Infrastructure\DeepSeek.Harness.Desktop.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 全局 using：Presentation 消费 Core 端口与 Infrastructure 适配器免逐文件 using；
         本工程按域命名空间（目录即命名空间），层内跨域引用同样免逐文件 using。 -->
    <Using Include="DeepSeek.Harness.Desktop" />
    <Using Include="DeepSeek.Harness.Desktop.Tray" />
    <Using Include="DeepSeek.Harness.Desktop.Update" />
    <Using Include="DeepSeek.Harness.Desktop.Bootstrap" />
    <Using Include="DeepSeek.Harness.Desktop.Recovery" />
    <Using Include="DeepSeek.Harness.Desktop.PageBridge" />
    <Using Include="DeepSeek.Harness.Desktop.Core" />
    <Using Include="DeepSeek.Harness.Desktop.Core.Update" />
    <Using Include="DeepSeek.Harness.Desktop.Core.Plugins" />
    <Using Include="DeepSeek.Harness.Desktop.Core.PageHealth" />
    <Using Include="DeepSeek.Harness.Desktop.Core.Localization" />
    <Using Include="DeepSeek.Harness.Desktop.Core.Bootstrap" />
    <Using Include="DeepSeek.Harness.Desktop.Infrastructure" />
    <Using Include="DeepSeek.Harness.Desktop.Infrastructure.Update" />
    <Using Include="DeepSeek.Harness.Desktop.Infrastructure.Bootstrap" />
    <Using Include="DeepSeek.Harness.Desktop.Infrastructure.Runtime" />
    <Using Include="DeepSeek.Harness.Desktop.Infrastructure.CliShim" />
    <Using Include="DeepSeek.Harness.Desktop.Infrastructure.Plugins" />
    <Using Include="DeepSeek.Harness.Desktop.Infrastructure.Platform" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="ryn.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="wwwroot/**" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\icon.png" Link="icon.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DeepSeek.Harness.Desktop.Tests" />
  </ItemGroup>

</Project>
