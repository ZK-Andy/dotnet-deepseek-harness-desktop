<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- 编码规范强制（见 docs/coding-standards.md）：AnalysisLevel 启用 .NET 分析器默认规则，
         EnforceCodeStyleInBuild 让 IDE 风格规则（var/命名/this./关键字等，见根 .editorconfig）
         在 build 中按 warning 执行；StyleCop.Analyzers 只启用 .editorconfig 显式声明为
         warning 的规则（其余类别 none）。 -->
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <!-- AD0001（分析器异常）抑制：StyleCop.Analyzers 1.1.118 在 C# 13/14 新语法（record 声明等）
         上抛异常；受影响的 SA 规则已按 .editorconfig 禁用或降级，崩溃噪音无分析价值。 -->
    <NoWarn>$(NoWarn);AD0001</NoWarn>
    <!-- 发布产物为 JIT：三条打包流水线均显式 JIT publish（macOS 交叉编需关 AOT），
         此处声明 false 使本地 publish 与发运一致。AOT 兼容（源生成 JSON）保留为裕度，
         周期验证可临时 -p:PublishAot=true。 -->
    <PublishAot>false</PublishAot>
    <!-- 自更新比较基准；发布时 CI 以 -p:Version=$(tag 去前缀) 覆盖 -->
    <Version>0.4.2</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Ryn" Version="0.32.0" />
    <PackageReference Include="Ryn.Plugins.Tray" Version="0.32.0" />
    <PackageReference Include="Ryn.Callbacks" Version="0.32.0" />
    <PackageReference Include="StyleCop.Analyzers" Version="1.1.118" PrivateAssets="all" />
    <PackageReference Include="Ryn.Ipc.Generator" Version="0.32.0"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="ryn.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="wwwroot/**" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\icon.png" Link="icon.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DeepSeek.Harness.Desktop.Tests" />
  </ItemGroup>

</Project>
