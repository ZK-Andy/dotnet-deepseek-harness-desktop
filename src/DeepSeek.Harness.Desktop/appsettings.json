{
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  },
  "Update": {
    "Repository": "ZK-Andy/dotnet-deepseek-harness-desktop",
    "FeedTimeoutSeconds": 15,
    "DownloadTimeoutMinutes": 30,
    "PkexecObserveSeconds": 10,
    "UpdatesDirName": "updates"
  },
  "RuntimeBootstrap": {
    "DshSpec": "@deepseek-ai/dsh@alpha",
    "StepTimeoutMinutes": 10,
    "FetchTextTimeoutSeconds": 30,
    "PreinstallPollIntervalMilliseconds": 200,
    "PreinstallChoiceTimeoutMinutes": 5,
    "NodeDistBaseUrl": "https://nodejs.org/dist",
    "NodeMirrorBaseUrl": "https://cdn.npmmirror.com/binaries/node"
  },
  "RuntimeTimeouts": {
    "RelayWaitIntervalSeconds": 1,
    "RelayHelperGraceSeconds": 2,
    "RelayReadyStableWindowSeconds": 2,
    "AdoptedExitPollIntervalSeconds": 1,
    "PortProbeTimeoutMilliseconds": 500,
    "WebProbeTimeoutMilliseconds": 1500,
    "LifecycleGateWaitSeconds": 3,
    "SpawnTimeoutSeconds": 60,
    "NotifyPrimaryTimeoutSeconds": 2,
    "SupervisorJoinTimeoutSeconds": 2,
    "SupervisorRestartTimeoutSeconds": 60,
    "SupervisorRecoveredRetryDelaySeconds": 2,
    "SupervisorFailedRetryDelaySeconds": 1,
    "HealthInitialDelaySeconds": 10,
    "BootstrapSettleTimeoutSeconds": 120,
    "NavCommitTimeoutSeconds": 5,
    "IpcServeTimeoutSeconds": 5,
    "IpcAcceptRetryDelaySeconds": 1,
    "VersionProbeTimeoutSeconds": 8,
    "BannerMaxAttempts": 30,
    "BannerRetryDelaySeconds": 1,
    "PushMaxAttempts": 15,
    "PushRetryDelayMilliseconds": 400
  }
}
