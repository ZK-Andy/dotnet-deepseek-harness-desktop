{
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  },
  "Update": {
    "Repository": "ZK-Andy/dotnet-deepseek-harness-desktop",
    "FeedTimeoutSeconds": 15,
    "DownloadTimeoutMinutes": 30,
    "UpdatesDirName": "updates"
  },
  "RuntimeBootstrap": {
    "NodeVersion": "24.20.0",
    "NodeDistBaseUrl": "https://nodejs.org/dist",
    "NodeMirrorBaseUrl": "https://cdn.npmmirror.com/binaries/node",
    "DshSpec": "@deepseek-ai/dsh@latest",
    "MinimumLocalNodeMajor": 22,
    "StepTimeoutMinutes": 10
  }
}
