#!/usr/bin/env bash
# pre-commit — 快检查（仅暂存区，不跑全量 build/test，CI 拥有穷尽矩阵）
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

echo "== pre-commit: 空白与门禁快检 =="

# 1) 空白错误（git 内置 check；--quiet 会因存在 diff 就返 1，需单独 --check）
if ! git diff --cached --check; then
  echo "error: 发现空白错误（行尾空格/缺换行），请修复后重试" >&2
  exit 1
fi

# 2) ADR 格式（仅当 .agents/notes/** 有暂存变更时）
if git diff --cached --name-only | grep -q "^\.agents/notes/"; then
  echo "-> verify-adr-format.py"
  python3 scripts/verify-adr-format.py
fi

# 3) Markdown 相对链接（快）
echo "-> verify-md-links.py"
python3 scripts/verify-md-links.py

# 4) cookbook（踩坑记录格式与阶段标签封闭集）
echo "-> verify-cookbook.py"
python3 scripts/verify-cookbook.py

# 5) doc-budgets（快）
echo "-> verify-doc-budgets.py"
python3 scripts/verify-doc-budgets.py --manifest scripts/doc-budgets.manifest.json

# 6) HANDOFF 结构（快；HANDOFF/.plan 为 gitignore 本地文档，仅存在即校验，CI 无则跳过）
echo "-> verify-handoff-structure.py"
python3 scripts/verify-handoff-structure.py

# 7) 治理面快检（快；模板漂移在此拦截）
echo "-> verify-governance.py"
python3 scripts/verify-governance.py

# 8) 架构尺寸健康闸（R4/R1：先拆再上硬门槛——diff 不得顶过阈值/触碰超阈值文件须先拆）
echo "-> verify-code-health.py"
python3 scripts/verify-code-health.py --enforce

# 9) 契约扫描（R3 边界/日志：D004 未走 HostLog、D005 非边界层直调基础设施）
echo "-> verify-code-conventions.py"
python3 scripts/verify-code-conventions.py --enforce

echo "pre-commit OK"
