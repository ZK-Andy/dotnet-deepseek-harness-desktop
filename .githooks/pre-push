#!/usr/bin/env bash
# pre-push — 增量 build/test（最小证据），hooks 只做快检查，CI 拥有穷尽矩阵
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

echo "== pre-push: 增量 build/test =="

# 变更范围（供人确认）
if [[ -x scripts/change-scope.sh ]]; then
  scripts/change-scope.sh || true
  echo
fi

# 增量面 = outgoing 已提交 + 工作树 + 已暂存（去重）。
# 教训（a3de599→25875fe）：只看工作树/index 时，已提交的 outgoing 变更在工作树干净即整个跳过
# dotnet 段，IDE0005 逃逸到 CI 才暴露。origin/main 缺失时回退工作树/index（提示可见）。
OUTGOING=""
if git rev-parse --verify origin/main >/dev/null 2>&1; then
  OUTGOING="$(git diff --name-only origin/main...HEAD 2>/dev/null || true)"
else
  echo "(origin/main 不存在，增量判定仅覆盖工作树/已暂存——CI 仍会全量拦截)"
fi
WORKTREE="$(git diff --name-only 2>/dev/null || true)"
CACHED="$(git diff --cached --name-only 2>/dev/null || true)"
CHANGED="$(printf '%s\n%s\n%s\n' "$OUTGOING" "$WORKTREE" "$CACHED" | sort -u)"
# src/tests 内容与 format 结论源（.editorconfig/slnx 结构）命中任一即跑 `dotnet` 段。
# 纯 .editorconfig 改动可翻转 format 结论却命中不了 ^(src|tests)/（R1 Suggestion），故一并纳入。
if echo "$CHANGED" | grep -qE "^(src|tests)/|\.slnx$|^\.editorconfig$"; then
  export DOTNET_CLI_HOME="$ROOT/.dotnet-cache/cli"
  export NUGET_PACKAGES="$ROOT/.dotnet-cache/nuget"
  echo "-> dotnet build -c Debug"
  dotnet build dotnet-deepseek-harness-desktop.slnx -c Debug --nologo -v q
  # 编码规范门禁（与 CI ubuntu 腿同命令）：IDE0005 的唯一强制路径，主工程 build 不报，
  # 缺此步即重演 a3de599 逃逸。置于 build 后、test 前，红即 fail loud。
  echo "-> dotnet format --verify-no-changes --severity warn"
  dotnet format dotnet-deepseek-harness-desktop.slnx --verify-no-changes --severity warn
  echo "-> dotnet test -c Debug --no-build"
  dotnet test dotnet-deepseek-harness-desktop.slnx -c Debug --no-build --nologo
else
  echo "src/tests 无变更，跳过 dotnet build/format/test（CI 仍会全量）"
fi

# 文档门禁（增量也跑，防推坏链接）
echo "-> 文档门禁"
python3 scripts/verify-adr-format.py
python3 scripts/verify-doc-budgets.py --manifest scripts/doc-budgets.manifest.json
python3 scripts/verify-md-links.py

# 评审档位硬闸（ADR review-tier-escape-proofing）：outgoing FULL 档变更须携带
# Review 证据；无证据即拦 push——行为级机械限制，杜绝「轻审跳过重三审」逃逸。
# --since origin/main：扫本次将推送的提交（已提交形态，工作树干净也能拦）。
echo "-> verify-review-tier.py --since origin/main --enforce"
if git rev-parse --verify origin/main >/dev/null 2>&1; then
  python3 scripts/verify-review-tier.py --since origin/main --enforce
else
  echo "  (origin/main 不存在，跳过——CI 仍会全量拦截)"
fi

echo "pre-push OK"
