#!/usr/bin/env bash
# pre-push — 增量 build/test（最小证据），hooks 只做快检查，CI 拥有穷尽矩阵
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

echo "== pre-push: 增量 build/test =="

# 变更范围（供人确认）
if [[ -x scripts/change-scope.sh ]]; then
  scripts/change-scope.sh || true
  echo
fi

# 仅当 src/** 或 tests/** 有变更时才跑 dotnet；否则跳过以省时
CHANGED="$(git diff --name-only HEAD 2>/dev/null || true; git diff --cached --name-only 2>/dev/null || true)"
if echo "$CHANGED" | grep -qE "^(src|tests)/"; then
  export DOTNET_CLI_HOME="$ROOT/.dotnet-cache/cli"
  export NUGET_PACKAGES="$ROOT/.dotnet-cache/nuget"
  echo "-> dotnet build -c Debug"
  dotnet build dotnet-deepseek-harness-desktop.slnx -c Debug --nologo -v q
  echo "-> dotnet test -c Debug --no-build"
  dotnet test dotnet-deepseek-harness-desktop.slnx -c Debug --no-build --nologo
else
  echo "src/tests 无变更，跳过 dotnet build/test（CI 仍会全量）"
fi

# 文档门禁（增量也跑，防推坏链接）
echo "-> 文档门禁"
python3 scripts/verify-adr-format.py
python3 scripts/verify-doc-budgets.py --manifest scripts/doc-budgets.manifest.json
python3 scripts/verify-md-links.py

echo "pre-push OK"
