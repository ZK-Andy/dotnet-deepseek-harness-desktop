# 本地工作文档（规划/复盘，不纳入公开仓库）
/HANDOFF.md
/.plan/

# .NET 通用忽略
bin/
obj/
.vs/
*.user
artifacts/
TestResults/
*.nupkg

# dotnet 首用/包的本地缓存（沙箱 /home 只读重定向）
/.dotnet-cache/

# 本地 pnpm store（scripts/bundle-runtime.sh 默认写到工作区；CI 由 actions/cache 缓存）
/.cache/

# Ryn 运行时生成的 saucer 会话缓存（SQLite 文件）
/.saucer

# 捆绑的 dsh 运行时（由 scripts/bundle-runtime.sh 生成，发布时组装）
resources/runtime/

# CodeGraph 本地代码索引（开发侧工具，codegraph init 生成）
/.codegraph/
