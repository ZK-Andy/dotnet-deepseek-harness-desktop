# 本地工作文档（规划/复盘，不纳入公开仓库）
/HANDOFF.md
/HANDOFF-todos.md
/.plan/

# noogenesis 本地工作区（含独立 .git 的 genes-cache，防 git add -A 误入暂存）
/.noogenesis/

# .NET 通用忽略
bin/
obj/
.vs/
*.user
artifacts/
TestResults/
*.nupkg

# Python（verify-*.py 门禁脚本运行缓存）
__pycache__/
*.pyc

# dotnet 首用/包的本地缓存（沙箱 /home 只读重定向）
/.dotnet-cache/

# 本地工具缓存（pnpm store / npm cache / 引导实验产物等工作区态）
/.cache/


# dev/存量场景的运行时目录（闭包已退役：RuntimeLocator 仍按此路径探测，
# 旧 checkout 残留或手工拼装会落这里，一律不入库）
resources/runtime/

# CodeGraph 本地代码索引（开发侧工具，codegraph init 生成）
/.codegraph/

# ZCode 本地会话工作目录
.zcode/

# 评审简报（本地工作文档，主会话启动评审前产出，供 verify-review-brief.py 校验）
/.review-briefs/
# 评审对象物理隔离副本（verify-review-brief.py --export 的 detached worktree）。
# 通配而非精确名：导出目录是临时产物，任何 .review-object* 变体都不该被 `git add -A` 吃进索引
# （2026-10-29 实证：`.review-object2` 未匹配精确规则，被当成嵌入式仓库写进 index）。
.review-object*/
.review-object*
# workspace memory (dsh-continual-evolve)
.evolve/

# 客户端侧工作区记忆（本机工作底稿，非事实源；事实家见 AGENTS.md「文档纪律」）
/.workbuddy/
